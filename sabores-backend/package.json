{
  "name": "recipe-api",
  "version": "1.0.0",
  "description": "Modern Recipe API with Node.js and Express",
  "main": "src/Api.js",
  "scripts": {
    "start": "node src/Api.js",
    "dev": "nodemon src/Api.js",
    "prod": "NODE_ENV=production node src/API.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "seed": "node scripts/seed.js",
    "migrate": "node scripts/migrate.js",
    "docker:build": "docker build -t recipe-api .",
    "docker:run": "docker run -p 3000:3000 recipe-api"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "morgan": "^1.10.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "express-rate-limit": "^6.10.0",
    "express-mongo-sanitize": "^2.2.0",
    "xss-clean": "^0.1.1",
    "hpp": "^0.2.3",
    "dotenv": "^16.0.3",
    "mongoose": "^7.0.3",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.0",
    "multer": "^1.4.5-lts.1",
    "uuid": "^9.0.0",
    "validator": "^13.9.0",
    "nodemailer": "^6.9.1",
    "winston": "^3.8.2"
  },
  "devDependencies": {
    "nodemon": "^2.0.22",
    "jest": "^29.5.0",
    "supertest": "^6.3.3",
    "eslint": "^8.38.0",
    "prettier": "^2.8.7",
    "@types/node": "^18.15.11",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.1"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "keywords": [
    "recipe",
    "api",
    "express",
    "mongodb",
    "rest-api",
    "nodejs"
  ],
  "author": "Your Name",
  "license": "MIT"
}